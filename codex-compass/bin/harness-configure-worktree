#!/usr/bin/env python3
"""Point Harness MCP servers at this worktree's installed code."""

import json
import os
import re
import stat
import tempfile
from pathlib import Path


SECTIONS = {"[mcp_servers.harness-state]", "[mcp_servers.harness-memory]"}
CWD_LINE = re.compile(r"^(\s*)cwd\s*=")


def main() -> int:
    project_root = Path(__file__).resolve().parents[2]
    config_path = project_root / ".codex/config.toml"
    if not config_path.is_file():
        raise SystemExit(f"Codex 설정 파일이 없습니다: {config_path}")

    lines = config_path.read_text().splitlines(keepends=True)
    current_section = None
    counts = {section: 0 for section in SECTIONS}
    target = json.dumps(str(project_root / "codex-compass"))
    for index, line in enumerate(lines):
        if line.lstrip().startswith("["):
            current_section = line.strip()
        elif current_section in SECTIONS:
            match = CWD_LINE.match(line)
            if match:
                counts[current_section] += 1
                ending = "\r\n" if line.endswith("\r\n") else "\n"
                lines[index] = f"{match.group(1)}cwd = {target}{ending}"

    if any(count != 1 for count in counts.values()):
        raise SystemExit("harness-state와 harness-memory의 cwd 설정이 각각 하나씩 있어야 합니다. 설정은 변경하지 않았습니다.")

    updated = "".join(lines)
    if updated != config_path.read_text():
        mode = stat.S_IMODE(config_path.stat().st_mode)
        descriptor, temporary = tempfile.mkstemp(prefix="config.toml.", dir=config_path.parent)
        try:
            with os.fdopen(descriptor, "w") as stream:
                stream.write(updated)
            os.chmod(temporary, mode)
            os.replace(temporary, config_path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    print(f"하네스 MCP 서버 경로를 설정했습니다: {project_root / 'codex-compass'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
