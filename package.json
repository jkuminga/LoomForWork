{
  "name": "loomforwork",
  "version": "0.1.0",
  "description": "A Codex harness for managing project work, runs, and reusable memory.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkuminga/LoomForWork.git"
  },
  "homepage": "https://github.com/jkuminga/LoomForWork#readme",
  "bugs": {
    "url": "https://github.com/jkuminga/LoomForWork/issues"
  },
  "keywords": [
    "codex",
    "harness",
    "work-items",
    "mcp",
    "agent-workflow",
    "memory",
    "worktree"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "loomforwork": "installer/cli.ts"
  },
  "files": [
    "installer/",
    "lfw/",
    "assets/loomforwork-hero.png",
    "assets/loomforwork-logo.png",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "console": "lfw/bin/harness-control-center",
    "verify:install": "lfw/bin/harness-verify-install",
    "worktree:setup": "lfw/bin/harness-configure-worktree",
    "memory:setup": "bun install --cwd lfw/vendor/memory-graph/ts --frozen-lockfile",
    "memory:recall": "bun run lfw/src/harness/memory/cli.ts",
    "test:python": "PYTHONPATH=lfw uv run --project lfw --locked python -m unittest discover -s tests -q",
    "test:memory": "bun test tests/memory",
    "typecheck:memory": "lfw/vendor/memory-graph/ts/node_modules/.bin/tsc --noEmit -p tsconfig.memory.json"
  }
}
