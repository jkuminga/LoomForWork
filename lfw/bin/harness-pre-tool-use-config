#!/usr/bin/env bun

import { randomUUID } from "node:crypto";
import { existsSync, lstatSync, mkdirSync, readFileSync, renameSync, rmSync, statSync, writeFileSync, chmodSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
const hooksPath = resolve(projectRoot, ".codex/hooks.json");
const command = '"$(git rev-parse --show-toplevel)/lfw/bin/harness-pre-tool-use"';
const harnessHook = {
  hooks: [{
    type: "command",
    command,
    timeout: 10,
    statusMessage: "Checking project work authorization",
  }],
};

function object(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function load(): Record<string, unknown> {
  if (!existsSync(hooksPath)) return { hooks: {} };
  if (lstatSync(hooksPath).isSymbolicLink()) throw new Error(`심볼릭 링크는 수정하지 않습니다: ${hooksPath}`);
  const parsed: unknown = JSON.parse(readFileSync(hooksPath, "utf8"));
  if (!object(parsed)) throw new Error("hooks.json의 최상위 값은 객체여야 합니다.");
  if (parsed.hooks === undefined) parsed.hooks = {};
  if (!object(parsed.hooks)) throw new Error("hooks.json의 hooks 값은 객체여야 합니다.");
  return parsed;
}

function preToolGroups(document: Record<string, unknown>): Record<string, unknown>[] {
  const hooks = document.hooks as Record<string, unknown>;
  if (hooks.PreToolUse === undefined) hooks.PreToolUse = [];
  if (!Array.isArray(hooks.PreToolUse) || hooks.PreToolUse.some(
    (group: unknown) => !object(group) || !Array.isArray(group.hooks) ||
      group.hooks.some((hook: unknown) => !object(hook)),
  )) {
    throw new Error("hooks.json의 PreToolUse 배열 형식이 잘못되었습니다.");
  }
  return hooks.PreToolUse as Record<string, unknown>[];
}

function save(document: Record<string, unknown>): void {
  mkdirSync(dirname(hooksPath), { recursive: true });
  const temporary = `${hooksPath}.${randomUUID()}.tmp`;
  try {
    writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`, {
      mode: existsSync(hooksPath) ? statSync(hooksPath).mode : 0o644,
    });
    if (existsSync(hooksPath)) chmodSync(temporary, statSync(hooksPath).mode);
    renameSync(temporary, hooksPath);
  } finally {
    if (existsSync(temporary)) rmSync(temporary);
  }
}

function main(): void {
  const action = process.argv[2];
  if ((action !== "enable" && action !== "disable") || process.argv.length !== 3) {
    throw new Error("사용법: lfw/bin/harness-pre-tool-use-config enable|disable");
  }
  if (action === "disable" && !existsSync(hooksPath)) {
    console.log("하네스 PreToolUse가 이미 비활성화되어 있습니다.");
    return;
  }
  const document = load();
  const groups = preToolGroups(document);
  const matching = (hook: unknown): boolean => object(hook) && hook.command === command;

  if (action === "enable") {
    if (groups.some((group) => (group.hooks as unknown[]).some(matching))) {
      console.log("하네스 PreToolUse가 이미 등록되어 있습니다.");
      return;
    }
    groups.unshift(harnessHook);
  } else {
    let removed = false;
    for (let index = groups.length - 1; index >= 0; index--) {
      const group = groups[index];
      const entries = group.hooks as unknown[];
      const remaining = entries.filter((hook) => !matching(hook));
      if (remaining.length === entries.length) continue;
      removed = true;
      if (remaining.length === 0) groups.splice(index, 1);
      else group.hooks = remaining;
    }
    if (!removed) {
      console.log("하네스 PreToolUse가 이미 비활성화되어 있습니다.");
      return;
    }
  }
  save(document);
  console.log(`하네스 PreToolUse ${action === "enable" ? "등록" : "등록 해제"} 완료. Codex에서 /hooks 상태를 확인하세요.`);
}

try {
  main();
} catch (error) {
  console.error(`[lfw] ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}
