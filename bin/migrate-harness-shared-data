#!/usr/bin/env python3
"""Move legacy worktree databases and Review Plans into Git common storage.

Run once while all other Harness sessions and the Control Center are stopped.
The original database files are retained under each worktree's .harness/backups/.
"""

from __future__ import annotations

import fcntl
import argparse
import hashlib
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from contextlib import closing
from datetime import datetime, timezone
from pathlib import Path


def command(*args: str) -> str:
    return subprocess.check_output(args, text=True).strip()


def checked_database(path: Path, expected_version: int | None = None) -> None:
    with closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True)) as db:
        if db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
            raise RuntimeError(f"SQLite integrity check failed: {path}")
        tables = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        required = {"work_items", "runs", "artifacts"} if path.name == "state.db" else {"memories", "relationships"}
        if not required <= tables:
            raise RuntimeError(f"expected tables missing from {path}: {sorted(required - tables)}")
        version = db.execute("PRAGMA user_version").fetchone()[0]
        if expected_version is not None and version != expected_version:
            raise RuntimeError(f"schema version {version} in {path}; expected {expected_version}")


def checksum(path: Path) -> str:
    with closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True)) as source, closing(sqlite3.connect(":memory:")) as snapshot:
        source.backup(snapshot)
        return hashlib.sha256("\n".join(snapshot.iterdump()).encode("utf-8")).hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--worktree", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    root = args.worktree.resolve()
    common = Path(command("git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"))
    shared = common / "harness-data"
    worktrees = [Path(line.removeprefix("worktree ")) for line in command("git", "-C", str(root), "worktree", "list", "--porcelain").splitlines() if line.startswith("worktree ")]
    databases = {name: [w / ".harness" / name for w in worktrees if (w / ".harness" / name).is_file()] for name in ("state.db", "memorygraph.db")}
    plans: dict[str, Path] = {}
    for worktree in worktrees:
        for path in (worktree / ".harness" / "review-plans").glob("*.json"):
            if path.is_symlink() or not path.is_file():
                raise RuntimeError(f"unsafe Review Plan path: {path}")
            if path.name in plans and path.read_bytes() != plans[path.name].read_bytes():
                raise RuntimeError(f"conflicting Review Plans for {path.name}: {plans[path.name]} and {path}")
            plans[path.name] = path
    for name, sources in databases.items():
        if not sources:
            raise RuntimeError(f"no legacy {name} found")
        for path in sources:
            checked_database(path)
        if len({checksum(path) for path in sources}) > 1:
            raise RuntimeError(f"multiple different {name} candidates: {sources}")
        if (shared / name).exists():
            raise RuntimeError(f"shared {name} already exists; will not overwrite")
    for name, source in plans.items():
        target = shared / "review-plans" / name
        if target.exists() and target.read_bytes() != source.read_bytes():
            raise RuntimeError(f"shared Review Plan conflicts with {source}")
    print("Worktrees:", *worktrees, sep="\n  ")
    for name, sources in databases.items():
        print(f"{name}: {sources[0]} ({len(sources)} identical candidate(s))")
    print(f"Review Plans: {len(plans)}")
    if not args.apply:
        print("Inspection only. Run with --apply after all other Harness processes are stopped.")
        return

    if shared.exists():
        raise RuntimeError(f"shared directory already exists; will not replace: {shared}")
    lock_path = common / ".harness-data-migration.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        with tempfile.TemporaryDirectory(prefix=".harness-data-stage-", dir=common) as stage_name:
            stage = Path(stage_name)
            stage.chmod(0o700)
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            for name, sources in databases.items():
                source = sources[0]
                destination = stage / name
                with closing(sqlite3.connect(f"file:{source}?mode=ro", uri=True)) as old, closing(sqlite3.connect(destination)) as new:
                    old.backup(new)
                    new.execute("PRAGMA user_version = 1")
                    new.commit()
                    checkpoint = new.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
                    if checkpoint is not None and checkpoint[0] != 0:
                        raise RuntimeError(f"WAL checkpoint did not complete for {name}: {checkpoint}")
                destination.chmod(0o600)
                checked_database(destination, expected_version=1)
            for name, source in plans.items():
                destination = stage / "review-plans" / name
                destination.parent.mkdir(mode=0o700, exist_ok=True)
                shutil.copyfile(source, destination)
                destination.chmod(0o600)
            if plans:
                sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
                from src.harness import review_plans

                for name in plans:
                    try:
                        review_plans.load_review_plan(Path(name).stem, database_path=stage / "state.db")
                    except Exception as error:
                        raise RuntimeError(f"Review Plan {name} needs user review before migration: {error}") from error
            for name in databases:
                checked_database(stage / name, expected_version=1)
            os.rename(stage, shared)
            for name in databases:
                checked_database(shared / name, expected_version=1)
            for name, sources in databases.items():
                for source in sources:
                    backup = source.parent / "backups" / f"shared-migration-{timestamp}"
                    backup.mkdir(mode=0o700, parents=True, exist_ok=True)
                    backup.chmod(0o700)
                    source.rename(backup / name)
                    for suffix in ("-wal", "-shm"):
                        sidecar = source.with_name(name + suffix)
                        if sidecar.exists():
                            sidecar.rename(backup / (name + suffix))
            print(f"Migrated databases and {len(plans)} Review Plans to {shared}")
            print("Legacy database files retained in worktree .harness/backups/shared-migration-*/")


if __name__ == "__main__":
    main()
